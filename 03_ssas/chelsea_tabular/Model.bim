          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": "ROW( \"Medidas\", 0 )"
            }
          }
        ],
        "measures": [
          {
            "name": "Minutos",
            "expression": "SUM( fato_desempenho[minutos] )",
            "formatString": "#,0",
            "displayFolder": "Tempo",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"NumberDecimal\" Accuracy=\"0\" ThousandSeparator=\"True\" />"
              }
            ]
          },
          {
            "name": "Partidas",
            "expression": "CALCULATE( DISTINCTCOUNT( dim_partida[sb_match_id] ), fato_desempenho )",
