                  dataType="System.String"
                  description="Especifica a instrução SQL que gera a tabela de pesquisa."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT *
FROM (VALUES
    (N'Goleiro',       N'Goleiro', 1, 1, 0),
    (N'Zagueiro',      N'Defesa',  2, 2, 1),
    (N'Lateral',       N'Defesa',  3, 2, 1),
    (N'Volante',       N'Meio',    4, 3, 1),
    (N'Meia central',  N'Meio',    5, 3, 0),
    (N'Meia aberto',   N'Meio',    6, 3, 0),
    (N'Meia ofensivo', N'Meio',    7, 3, 0),
    (N'Ponta',         N'Ataque',  8, 4, 0),
    (N'Atacante',      N'Ataque',  9, 4, 0)
) AS g (grupo, setor, ordem_grupo, ordem_setor, eh_escopo);</property>
                <property
                  dataType="System.String"
                  description="Especifica uma instrução SQL que usa parâmetros para gerar a tabela de pesquisa."
                  expressionType="Notify"
                  name="SqlCommandParam"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from (SELECT *
FROM (VALUES
    (N'Goleiro',       N'Goleiro', 1, 1, 0),
    (N'Zagueiro',      N'Defesa',  2, 2, 1),
    (N'Lateral',       N'Defesa',  3, 2, 1),
    (N'Volante',       N'Meio',    4, 3, 1),
    (N'Meia central',  N'Meio',    5, 3, 0),
    (N'Meia aberto',   N'Meio',    6, 3, 0),
    (N'Meia ofensivo', N'Meio',    7, 3, 0),
    (N'Ponta',         N'Ataque',  8, 4, 0),
    (N'Atacante',      N'Ataque',  9, 4, 0)
) AS g (grupo, setor, ordem_grupo, ordem_setor, eh_escopo);) [refTable]
where [refTable].[grupo] = ?</property>
