            <component
              refId="Package\dim_partida\Partidas"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="Origem OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos os Direitos Reservados; http://www.microsoft.com/sql/support;7"
              description="Origem OLE DB"
              name="Partidas"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="O tempo em segundos antes que um comando expire. Zero indica uma expiração infinita."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica o nome do objeto de banco de dados usado para abrir um conjunto de linhas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica a variável que contém o nome do objeto de banco de dados usado para abrir um conjunto de linhas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="O comando SQL a ser executado."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH partidas AS (          -- 1. cada partida SB com o seu jogo TM (D6.4: data + mandante + visitante)
    SELECT m.match_id, m.match_week, m.home_team_id, m.away_team_id,
           g.game_id, g.competition_id, g.season, g.date,
           g.home_club_id, g.away_club_id, g.home_club_goals, g.away_club_goals,
           g.home_club_manager_name, g.away_club_manager_name,
           g.home_club_formation, g.away_club_formation,
           tc.nome AS nome_casa, tf.nome AS nome_fora,
           tc.posicao_2015_16 AS posicao_casa, tf.posicao_2015_16 AS posicao_fora
    FROM stg.sb_matches m
    JOIN dw.dim_time tc ON tc.sb_team_id = m.home_team_id
    JOIN dw.dim_time tf ON tf.sb_team_id = m.away_team_id
    JOIN stg.tm_games g ON g.home_club_id = tc.tm_club_id
                       AND g.away_club_id = tf.tm_club_id
                       AND g.date = m.match_date
),
lados AS (                  -- 2. cada partida vira 2 linhas: o lado do mandante e o do visitante
    SELECT match_id, home_team_id AS sb_team_id, game_id, home_club_id AS tm_club_id,
           competition_id, season, date, match_week, nome_casa, nome_fora,
           home_club_goals, away_club_goals,
           N'Casa' AS mando, nome_fora AS adversario, posicao_fora AS posicao_adversario,
           home_club_manager_name AS tecnico, away_club_manager_name AS tecnico_adversario,
           home_club_formation AS formacao, away_club_formation AS formacao_adversario,
           home_club_goals AS gols_pro, away_club_goals AS gols_contra
    FROM partidas
    UNION ALL
    SELECT match_id, away_team_id, game_id, away_club_id,
           competition_id, season, date, match_week, nome_casa, nome_fora,
           home_club_goals, away_club_goals,
           N'Fora', nome_casa, posicao_casa,
           away_club_manager_name, home_club_manager_name,
           away_club_formation, home_club_formation,
           away_club_goals, home_club_goals
    FROM partidas
)
SELECT match_id AS sb_match_id, sb_team_id, game_id AS tm_game_id, tm_club_id,
       date AS data, season, competition_id, match_week AS rodada,
       nome_casa, nome_fora, home_club_goals, away_club_goals,
       mando, adversario, posicao_adversario AS posicao_adversario_2015_16,
       tecnico, tecnico_adversario, formacao, formacao_adversario,
       gols_pro, gols_contra
FROM lados
ORDER BY date, match_id, mando</property>
                <property
                  dataType="System.String"
                  description="A variável que contém o comando SQL a ser executado."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Especifica a página de código de coluna a ser usada quando não há informações de página de código disponíveis a partir da fonte de dados."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Forca o uso do valor da propriedade DefaultCodePage durante a descrição dos dados de caractere."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Especifica o modo usado para acessar o banco de dados."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="Os mapeamentos entre os parâmetros no comando SQL e as variáveis."
                  name="ParameterMapping"></property>
              </properties>
              <connections>
                <connection
                  refId="Package\dim_partida\Partidas.Connections[OleDbConnection]"
                  connectionManagerID="{C6E32CC7-5721-4560-919F-C276BD5F39BF}:external"
                  connectionManagerRefId="Project.ConnectionManagers[chelsea_ssis]"
                  description="A conexão de tempo de execução OLE DB usada para acessar o banco de dados."
                  name="OleDbConnection" />
              </connections>
              <outputs>
                <output
                  refId="Package\dim_partida\Partidas.Outputs[Saída de Origem OLE DB]"
                  name="Saída de Origem OLE DB">
                  <outputColumns>
                    <outputColumn
                      refId="Package\dim_partida\Partidas.Outputs[Saída de Origem OLE DB].Columns[sb_match_id]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversão"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\dim_partida\Partidas.Outputs[Saída de Origem OLE DB].ExternalColumns[sb_match_id]"
                      lineageId="Package\dim_partida\Partidas.Outputs[Saída de Origem OLE DB].Columns[sb_match_id]"
                      name="sb_match_id"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\dim_partida\Partidas.Outputs[Saída de Origem OLE DB].Columns[sb_team_id]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversão"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\dim_partida\Partidas.Outputs[Saída de Origem OLE DB].ExternalColumns[sb_team_id]"
                      lineageId="Package\dim_partida\Partidas.Outputs[Saída de Origem OLE DB].Columns[sb_team_id]"
                      name="sb_team_id"
