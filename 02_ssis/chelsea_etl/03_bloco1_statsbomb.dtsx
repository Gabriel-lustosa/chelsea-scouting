            <component
              refId="Package\dim_time\Posicao final"
              componentClassID="Microsoft.Lookup"
              contactInfo="Pesquisa;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos os Direitos Reservados; http://www.microsoft.com/sql/support;6"
              description="Une colunas adicionais aos fluxos de dados pesquisando valores de uma tabela. Por exemplo, una à coluna 'employee id' a tabela de funcionários para obter 'hire date' e 'employee name'. Essa transformação é recomendada quando a tabela de pesquisa está de acordo com a memória."
              name="Posicao final"
              usesDispositions="true"
              version="6">
              <properties>
                <property
                  dataType="System.String"
                  description="Especifica a instrução SQL que gera a tabela de pesquisa."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH jogos_tm AS (          -- posição de cada clube depois de cada jogo da liga (TM)
    SELECT home_club_id AS tm_club_id, date, home_club_position AS posicao
    FROM stg.tm_games WHERE season = 2015 AND competition_id IN ('GB1', 'ES1', 'IT1', 'FR1')
    UNION ALL
    SELECT away_club_id, date, away_club_position
    FROM stg.tm_games WHERE season = 2015 AND competition_id IN ('GB1', 'ES1', 'IT1', 'FR1')
),
posicao_final AS (          -- fica só o último jogo de cada clube
    SELECT tm_club_id, posicao,
           ROW_NUMBER() OVER (PARTITION BY tm_club_id ORDER BY date DESC) AS ultimo
    FROM jogos_tm
)
SELECT tm_club_id, posicao
FROM posicao_final
WHERE ultimo = 1</property>
                <property
                  dataType="System.String"
                  description="Especifica uma instrução SQL que usa parâmetros para gerar a tabela de pesquisa."
                  expressionType="Notify"
                  name="SqlCommandParam"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from (WITH jogos_tm AS (          -- posição de cada clube depois de cada jogo da liga (TM)
    SELECT home_club_id AS tm_club_id, date, home_club_position AS posicao
    FROM stg.tm_games WHERE season = 2015 AND competition_id IN ('GB1', 'ES1', 'IT1', 'FR1')
    UNION ALL
    SELECT away_club_id, date, away_club_position
    FROM stg.tm_games WHERE season = 2015 AND competition_id IN ('GB1', 'ES1', 'IT1', 'FR1')
),
posicao_final AS (          -- fica só o último jogo de cada clube
    SELECT tm_club_id, posicao,
           ROW_NUMBER() OVER (PARTITION BY tm_club_id ORDER BY date DESC) AS ultimo
    FROM jogos_tm
)
SELECT tm_club_id, posicao
FROM posicao_final
WHERE ultimo = 1) [refTable]
where [refTable].[tm_club_id] = ?</property>
