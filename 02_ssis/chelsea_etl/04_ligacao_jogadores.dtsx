                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT j.sb_player_id, t.sb_team_id, t.tm_club_id, j.nome, j.nome_completo
FROM dw.fato_desempenho f
JOIN dw.dim_jogador j ON j.sk_jogador = f.sk_jogador
JOIN dw.dim_time t    ON t.sk_time = f.sk_time
ORDER BY j.sb_player_id, t.sb_team_id;</property>
