    <DTS:Executable
      DTS:refId="Package\Elenco TM 2015-16"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{F7FD1354-716D-4F03-A589-33B4A883F724}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Elenco TM 2015-16"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C6E32CC7-5721-4560-919F-C276BD5F39BF}"
          SQLTask:SqlStatementSource="-- Limpa a ligacao e recarrega o elenco do TM 2015/16 (D21.3), igual ao 05_dw_carga.sql:&#xA;-- quem atuou pelos 80 clubes do StatsBomb na temporada, em qualquer competicao.&#xA;TRUNCATE TABLE stg.ligacao_jogadores;&#xA;TRUNCATE TABLE stg.tm_elenco_2015_16;&#xA;INSERT INTO stg.tm_elenco_2015_16 (tm_club_id, tm_player_id, tm_nome)&#xA;SELECT DISTINCT a.player_club_id, a.player_id, p.name&#xA;FROM stg.tm_appearances a&#xA;JOIN stg.tm_games g   ON g.game_id = a.game_id&#xA;JOIN stg.tm_players p ON p.player_id = a.player_id&#xA;WHERE g.season = 2015&#xA;  AND a.player_club_id IN (SELECT tm_club_id FROM dw.dim_time WHERE sb_team_id IS NOT NULL);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
