      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C6E32CC7-5721-4560-919F-C276BD5F39BF}"
          SQLTask:SqlStatementSource="-- tm_player_id na dim_jogador (D18.4), igual ao 05_dw_carga.sql&#xA;UPDATE j&#xA;SET j.tm_player_id = l.tm_player_id&#xA;FROM dw.dim_jogador j&#xA;JOIN (SELECT DISTINCT sb_player_id, tm_player_id&#xA;      FROM stg.ligacao_jogadores) l ON l.sb_player_id = j.sb_player_id;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
