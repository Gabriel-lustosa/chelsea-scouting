                      cachedName="_Similarity"
                      lineageId="Package\Ligacao\Difusa no apelido.Outputs[Saída de Pesquisa Difusa].Columns[_Similarity]" />
                  </inputColumns>
                  <externalMetadataColumns />
                </input>
              </inputs>
              <outputs>
                <output
                  refId="Package\Ligacao\Limite apelido.Outputs[Ligado no apelido]"
                  description="Saída 1 da Transformação Divisão Condicional"
                  errorOrTruncationOperation="Computação"
                  errorRowDisposition="FailComponent"
                  exclusionGroup="1"
                  name="Ligado no apelido"
                  synchronousInputId="Package\Ligacao\Limite apelido.Inputs[Entrada de Divisão Condicional]"
                  truncationRowDisposition="FailComponent">
                  <properties>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Especifica a expressão. Essa versão da expressão usa identificadores de linhagem, em vez de nomes de colunas."
