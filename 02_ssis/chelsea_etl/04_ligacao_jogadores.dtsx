          SQLTask:SqlStatementSource="THROW 50003, 'Jogador do StatsBomb sem ligacao no Transfermarkt. Veja a variavel SemLigacao.', 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
