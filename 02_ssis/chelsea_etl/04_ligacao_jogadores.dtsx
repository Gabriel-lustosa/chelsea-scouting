    (16426,  236202, 5, N'Nome único no TM: Wanderson'),
    (25345,  52897,  5, N'Nome único no TM: Hernanes'),
    (27558,  59938,  5, N'Nome único no TM: Elderson'),
    (30767,  79242,  5, N'Nome único no TM: Gabriel'),
    (40945,  15420,  5, N'Nome único no TM: Alex'),
    (386515, 146660, 5, N'Nome único no TM: Ronaldo'),
    (387428, 6234,   5, N'Nome único no TM: Amauri'),
    (401489, 20410,  5, N'Nome único no TM: Jussiê'),
    (401541, 14948,  5, N'Nome único no TM: Brandão')
) AS e (sb_player_id, tm_player_id, regra, motivo);</property>
                <property
