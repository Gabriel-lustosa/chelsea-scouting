    <DTS:Executable
      DTS:refId="Package\Atributos do TM"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{DC2734E9-4EE5-40CD-96ED-6C55C35129DA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Atributos do TM"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C6E32CC7-5721-4560-919F-C276BD5F39BF}"
          SQLTask:SqlStatementSource="-- D19.1: nascimento, idade em 01/07/2016 (D6.6), pé em português e altura&#xA;UPDATE j&#xA;SET j.data_nascimento = CAST(p.date_of_birth AS DATE),&#xA;    -- anos completos: diferença de anos, menos 1 se o aniversário ainda não chegou em 01/07/2016&#xA;    j.idade_2016 = DATEDIFF(YEAR, p.date_of_birth, '20160701')&#xA;                 - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, p.date_of_birth, '20160701'), p.date_of_birth) &gt; '20160701'&#xA;                        THEN 1 ELSE 0 END,&#xA;    j.pe = CASE p.foot WHEN N'right' THEN N'Direito'&#xA;                       WHEN N'left'  THEN N'Esquerdo'&#xA;                       WHEN N'both'  THEN N'Ambos' END,&#xA;    j.altura_cm = p.height_in_cm&#xA;FROM dw.dim_jogador j&#xA;JOIN stg.tm_players p ON p.player_id = j.tm_player_id;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\dim_jogador Chelsea 14-15"
