    <DTS:Executable
      DTS:refId="Package\Limpar Bloco 2"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{569854ED-A310-4AED-9B25-666C0301DD99}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Limpar Bloco 2"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C6E32CC7-5721-4560-919F-C276BD5F39BF}"
          SQLTask:SqlStatementSource="-- Limpa o Bloco 2 para o pacote rodar de novo sozinho (Aula 30): as fatos de mercado e as&#xA;-- linhas só do Transfermarkt nas 3 dimensões. O Bloco 1 (linhas com chave do StatsBomb) fica.&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_jogador WHERE tm_player_id IS NOT NULL)&#xA;    THROW 50005, 'dim_jogador sem tm_player_id: rode o 03 e o 04 antes do 05.', 1;&#xA;&#xA;TRUNCATE TABLE dw.fato_atuacao;&#xA;TRUNCATE TABLE dw.fato_valor_mercado;&#xA;TRUNCATE TABLE dw.fato_transferencia;&#xA;&#xA;DELETE FROM dw.dim_partida WHERE sb_match_id  IS NULL;&#xA;DELETE FROM dw.dim_time    WHERE sb_team_id   IS NULL;&#xA;DELETE FROM dw.dim_jogador WHERE sb_player_id IS NULL;&#xA;&#xA;-- RESEED no maior SK que ficou: o próximo IDENTITY é esse + 1, e as SKs do Bloco 2 saem&#xA;-- iguais às do oficial (o DELETE, ao contrário do TRUNCATE, não reinicia o IDENTITY)&#xA;DECLARE @sk INT;&#xA;SELECT @sk = MAX(sk_jogador) FROM dw.dim_jogador;&#xA;DBCC CHECKIDENT ('dw.dim_jogador', RESEED, @sk) WITH NO_INFOMSGS;&#xA;SELECT @sk = MAX(sk_time) FROM dw.dim_time;&#xA;DBCC CHECKIDENT ('dw.dim_time', RESEED, @sk) WITH NO_INFOMSGS;&#xA;SELECT @sk = MAX(sk_partida) FROM dw.dim_partida;&#xA;DBCC CHECKIDENT ('dw.dim_partida', RESEED, @sk) WITH NO_INFOMSGS;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
