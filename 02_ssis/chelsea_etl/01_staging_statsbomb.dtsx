      DTS:LocaleID="-1"
      DTS:ObjectName="Loop partidas">
      <DTS:ForEachEnumerator
        DTS:CreationName="Microsoft.ForEachADOEnumerator"
        DTS:DTSID="{62DF0306-BD8E-413D-AD73-D1097803E11E}"
        DTS:ObjectName="{62DF0306-BD8E-413D-AD73-D1097803E11E}">
